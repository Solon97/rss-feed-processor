# ============================================================
# RSS Feed Processor — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# Variáveis marcadas como [OBRIGATÓRIA] causam falha na inicialização se ausentes.
# ============================================================

# ===== APLICAÇÃO =====

# Porta em que o servidor HTTP escuta
PORT=3001

# ===== BANCO DE DADOS =====

# [OBRIGATÓRIA] String de conexão PostgreSQL (usada pela fila pg-boss e pelo ORM)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Com Supabase: use a URL do connection pooler (porta 6543) para queries da aplicação
DATABASE_URL=postgresql://user:password@localhost:5432/feedagg

# URL de conexão direta ao banco (sem pooler) — usada pelo Prisma Migrate
# Com Supabase: use a URL de conexão direta (porta 5432) para evitar problemas com o PgBouncer
# Opcional: se não definida, o Prisma Migrate usará DATABASE_URL
DIRECT_URL=postgresql://user:password@localhost:5432/feedagg

# ===== SUPABASE =====
# Obtenha as informações abaixo em: https://app.supabase.com → Settings → API

# [OBRIGATÓRIA] URL do projeto Supabase (campo "Project URL")
SUPABASE_URL=https://your-project.supabase.co

# [OBRIGATÓRIA] Chave pública anônima ("anon public") — segura para expor no cliente
SUPABASE_ANON_KEY=your_supabase_anon_key

# [OBRIGATÓRIA] Chave de service role ("service_role") — ⚠️ MANTENHA SECRETA, nunca exponha no cliente
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# [OBRIGATÓRIA] URL JWKS para verificação de tokens JWT
# Formato: https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ===== STRIPE =====
# Obtenha as chaves em: https://dashboard.stripe.com/apikeys
# Obtenha o webhook secret em: https://dashboard.stripe.com/webhooks

# Habilita a integração com o Stripe. Quando "false", as variáveis abaixo não são obrigatórias
# e todas as rotas Stripe retornam 403 Forbidden.
ENABLE_STRIPE=false

# [OBRIGATÓRIA quando ENABLE_STRIPE=true] Chave secreta da API Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# [OBRIGATÓRIA quando ENABLE_STRIPE=true] Secret do endpoint de webhook Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret

# [OBRIGATÓRIA quando ENABLE_STRIPE=true] ID do preço Stripe para o plano mensal
# Crie em: https://dashboard.stripe.com/products
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id

# [OBRIGATÓRIA quando ENABLE_STRIPE=true] ID do preço Stripe para o plano anual
STRIPE_YEARLY_PRICE_ID=price_your_yearly_price_id

# ===== RESEND (EMAIL) =====
# Crie sua conta e chave em: https://resend.com/api-keys

# Habilita o envio de emails via Resend. Quando "false", as variáveis abaixo não são
# obrigatórias e todos os envios de email são ignorados silenciosamente.
ENABLE_EMAIL=false

# [OBRIGATÓRIA quando ENABLE_EMAIL=true] Chave de API do Resend para envio de emails
RESEND_API_KEY=re_your_resend_api_key

# [OBRIGATÓRIA quando ENABLE_EMAIL=true] Endereço remetente dos emails — deve ser um domínio verificado no Resend
# Em desenvolvimento você pode usar: onboarding@resend.dev
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Email de suporte exibido nos rodapés dos emails transacionais
SUPPORT_EMAIL=support@feedagg.com

# ===== YOUTUBE DATA API =====
# Necessário para buscar duração de vídeos do YouTube nos feeds
# Crie uma credencial em: https://console.developers.google.com/

# [OBRIGATÓRIA] Chave da YouTube Data API v3
YOUTUBE_API_KEY=AIzaSyCYO9TYX9rSBp0cqFJHzfsjpRRpg_vkE8E

# ===== FRONTEND =====

# URL base do frontend — usada para construir links em emails e redirects
FRONTEND_URL=http://localhost:3000

# ===== WEBHOOK =====

# Token de autenticação para proteger endpoints de webhook internos
# Qualquer string secreta e aleatória serve (ex: gerada com `openssl rand -hex 32`)
WEBHOOK_AUTH_TOKEN=your_random_webhook_auth_token

# ===== CRON JOBS =====
# Formato cron: https://crontab.guru/
# Valores padrão já definidos no código — só defina para sobrescrever.

# [OBRIGATÓRIA] Expressão cron para agendar o processamento dos feeds
# Padrão: a cada 30 minutos
FEED_PROCESSING_CRON=0,30 * * * *

# [OBRIGATÓRIA] Expressão cron para a verificação de saúde da fila
# Padrão: a cada 5 minutos
QUEUE_HEALTH_CHECK_CRON=0/5 * * * *

# ===== WORKERS DA FILA (PG-BOSS) =====
# Quantidade de workers locais por fila (por instância da aplicação).
# Use valores maiores para aumentar processamento em paralelo.

# Workers para fila de processamento padrão de feeds
QUEUE_FEED_DEFAULT_CONCURRENCY=3

# Workers para fila prioritária de feeds
QUEUE_FEED_PRIORITY_CONCURRENCY=2

# Workers para fila de processamento de emails
QUEUE_EMAIL_CONCURRENCY=3