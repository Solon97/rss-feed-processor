# ============================================================
# RSS Feed Processor — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# Variáveis marcadas como [OBRIGATÓRIA] causam falha na inicialização se ausentes.
# ============================================================

# ===== APLICAÇÃO =====

# Porta em que o servidor HTTP escuta
PORT=3001

# ===== BANCO DE DADOS =====

# [OBRIGATÓRIA] String de conexão PostgreSQL (usada pela fila pg-boss e pelo ORM)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/feedagg

# ===== SUPABASE =====
# Obtenha as informações abaixo em: https://app.supabase.com → Settings → API

# [OBRIGATÓRIA] URL do projeto Supabase (campo "Project URL")
SUPABASE_URL=https://your-project.supabase.co

# [OBRIGATÓRIA] Chave pública anônima ("anon public") — segura para expor no cliente
SUPABASE_ANON_KEY=your_supabase_anon_key

# [OBRIGATÓRIA] Chave de service role ("service_role") — ⚠️ MANTENHA SECRETA, nunca exponha no cliente
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# [OBRIGATÓRIA] URL JWKS para verificação de tokens JWT
# Formato: https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ===== STRIPE =====
# Obtenha as chaves em: https://dashboard.stripe.com/apikeys
# Obtenha o webhook secret em: https://dashboard.stripe.com/webhooks

# [OBRIGATÓRIA] Chave secreta da API Stripe (sk_live_... em produção, sk_test_... em desenvolvimento)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# [OBRIGATÓRIA] Secret do endpoint de webhook Stripe para verificar assinatura das requisições
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret

# [OBRIGATÓRIA] ID do preço Stripe para o plano mensal
# Crie em: https://dashboard.stripe.com/products
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id

# [OBRIGATÓRIA] ID do preço Stripe para o plano anual
STRIPE_YEARLY_PRICE_ID=price_your_yearly_price_id

# ===== RESEND (EMAIL) =====
# Crie sua conta e chave em: https://resend.com/api-keys

# [OBRIGATÓRIA] Chave de API do Resend para envio de emails
RESEND_API_KEY=re_your_resend_api_key

# [OBRIGATÓRIA] Endereço remetente dos emails — deve ser um domínio verificado no Resend
# Em desenvolvimento você pode usar: onboarding@resend.dev
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Email de suporte exibido nos rodapés dos emails transacionais
SUPPORT_EMAIL=support@feedagg.com

# ===== YOUTUBE DATA API =====
# Necessário para buscar duração de vídeos do YouTube nos feeds
# Crie uma credencial em: https://console.developers.google.com/

# [OBRIGATÓRIA] Chave da YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# ===== FRONTEND =====

# URL base do frontend — usada para construir links em emails e redirects
FRONTEND_URL=http://localhost:3000

# ===== WEBHOOK =====

# Token de autenticação para proteger endpoints de webhook internos
# Qualquer string secreta e aleatória serve (ex: gerada com `openssl rand -hex 32`)
WEBHOOK_AUTH_TOKEN=your_random_webhook_auth_token

# ===== CRON JOBS =====
# Formato cron: https://crontab.guru/
# Valores padrão já definidos no código — só defina para sobrescrever.

# [OBRIGATÓRIA] Expressão cron para agendar o processamento dos feeds
# Padrão: a cada 30 minutos
FEED_PROCESSING_CRON=0,30 * * * *

# [OBRIGATÓRIA] Expressão cron para a verificação de saúde da fila
# Padrão: a cada 5 minutos
QUEUE_HEALTH_CHECK_CRON=0/5 * * * *

# ===== TIMEOUTS (em milissegundos) =====

# Timeout para buscar o arquivo RSS/Atom do feed
RSS_FETCH_TIMEOUT=5000

# Timeout para buscar o HTML do site do feed (detecção de favicon, etc.)
WEBSITE_FETCH_TIMEOUT=10000

# Timeout para buscar o conteúdo completo de um artigo
CONTENT_FETCH_TIMEOUT=15000

# Timeout para extração de conteúdo de um artigo
CONTENT_EXTRACTION_TIMEOUT=30000

# Timeout para o parser de RSS/Atom
FEED_PARSING_TIMEOUT=15000

# ===== PROCESSAMENTO DE FEEDS =====

# Número máximo de itens a retornar por feed em uma requisição
MAX_FEED_ITEMS=5

# Número máximo de itens novos a processar por execução do job de feed
MAX_FEED_ITEMS_TO_PROCESS=10

# User-Agent enviado nas requisições HTTP para buscar feeds e conteúdos
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"

# ===== FILA (pg-boss) =====

# Número de jobs processados em paralelo por worker
QUEUE_CONCURRENCY=5

# Número máximo de vezes que um job pode ficar "stalled" antes de ser descartado
QUEUE_MAX_STALLED_COUNT=3

# Delay entre tentativas de retry de um job falho (em milissegundos)
QUEUE_RETRY_DELAY=2000
