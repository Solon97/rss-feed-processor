generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

enum FeedType {
    youtube
    rss
}

model feed_items {
    id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    feed_id      String    @db.Uuid
    title        String
    url          String
    content      String?   @db.Text
    thumbnail    String?
    duration     String? // Duration in ISO 8601 format (e.g., "PT10M30S" for 10 minutes 30 seconds)
    published_at DateTime  @db.Timestamptz(6)
    created_at   DateTime? @default(now()) @db.Timestamptz(6)
    feeds        feeds     @relation(fields: [feed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([feed_id, url])
    @@index([created_at], map: "idx_feed_items_created_at")
    @@index([feed_id], map: "idx_feed_items_feed_id")
    @@index([published_at], map: "idx_feed_items_published_at")
    @@index([feed_id, published_at(sort: Desc)], map: "idx_feed_items_feed_published")
    @@index([feed_id, created_at(sort: Desc)], map: "idx_feed_items_feed_created")
}

model feeds {
    id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name            String
    url             String       @unique
    feed_type       FeedType
    is_active       Boolean?     @default(true)
    status          String?      @default("active")
    created_at      DateTime?    @default(now()) @db.Timestamptz(6)
    updated_at      DateTime?    @default(now()) @db.Timestamptz(6)
    last_fetched_at DateTime?    @db.Timestamptz(6)
    feed_items      feed_items[]
    user_feeds      user_feeds[]

    @@index([created_at], map: "idx_feeds_created_at")
    @@index([is_active], map: "idx_feeds_is_active")
    @@index([status], map: "idx_feeds_status")
    @@index([url], map: "idx_feeds_url")
    @@index([feed_type], map: "idx_feeds_feed_type")
}

model topics {
    id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name       String
    user_id    String       @db.Uuid
    color      String?
    created_at DateTime?    @default(now()) @db.Timestamptz(6)
    updated_at DateTime?    @default(now()) @db.Timestamptz(6)
    user_feeds user_feeds[]

    @@unique([user_id, name])
    @@index([user_id], map: "idx_topics_user_id")
    @@index([created_at], map: "idx_topics_created_at")
}

model user_feeds {
    user_id                String    @db.Uuid
    feed_id                String    @db.Uuid
    topic_id               String    @db.Uuid
    is_active              Boolean?  @default(true)
    access_permissions     String?   @default("read")
    last_viewed_at         DateTime? @db.Timestamptz(6)
    notification_enabled   Boolean?  @default(true)
    notification_frequency String?   @default("immediate")
    created_at             DateTime? @default(now()) @db.Timestamptz(6)
    updated_at             DateTime? @default(now()) @db.Timestamptz(6)
    feeds                  feeds     @relation(fields: [feed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    topics                 topics    @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@id([user_id, feed_id])
    @@index([created_at], map: "idx_user_feeds_created_at")
    @@index([feed_id], map: "idx_user_feeds_feed_id")
    @@index([topic_id], map: "idx_user_feeds_topic_id")
    @@index([is_active], map: "idx_user_feeds_is_active")
    @@index([last_viewed_at], map: "idx_user_feeds_last_viewed_at")
    @@index([user_id], map: "idx_user_feeds_user_id")
    @@index([user_id, is_active, topic_id], map: "idx_user_feeds_user_active_topic")
    @@index([user_id, is_active], map: "idx_user_feeds_user_active")
}

model stripe_customers {
    id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    user_id            String    @unique @db.Uuid
    stripe_customer_id String    @unique
    email              String
    created_at         DateTime? @default(now()) @db.Timestamptz(6)
    updated_at         DateTime? @default(now()) @db.Timestamptz(6)

    @@index([user_id], map: "idx_stripe_customers_user_id")
    @@index([stripe_customer_id], map: "idx_stripe_customers_stripe_id")
}

model user_subscriptions {
    id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    user_id                String    @db.Uuid
    stripe_subscription_id String    @unique
    stripe_customer_id     String
    status                 String    @default("active")
    current_period_start   DateTime  @db.Timestamptz(6)
    current_period_end     DateTime  @db.Timestamptz(6)
    created_at             DateTime? @default(now()) @db.Timestamptz(6)
    updated_at             DateTime? @default(now()) @db.Timestamptz(6)

    @@index([user_id], map: "idx_user_subscriptions_user_id")
    @@index([status], map: "idx_user_subscriptions_status")
    @@index([stripe_subscription_id], map: "idx_user_subscriptions_stripe_id")
    @@index([current_period_end], map: "idx_user_subscriptions_period_end")
}
