# Variáveis de ambiente para a aplicação RSS Feed Processor

# Porta da aplicação
PORT=3001

# Redis Configuration (para sistema de filas)
# Use REDIS_URL para configuração completa (recomendado para produção)
REDIS_URL=redis://localhost:6379/0

# Configurações separadas (mantidas para compatibilidade - serão removidas no futuro)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Timeouts (em milissegundos)
RSS_FETCH_TIMEOUT=5000
WEBSITE_FETCH_TIMEOUT=10000
CONTENT_FETCH_TIMEOUT=15000

# User Agent para requisições HTTP
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"

# Máximo de itens a processar por feed
MAX_FEED_ITEMS=5

# Queue Configuration  
QUEUE_CONCURRENCY=5
QUEUE_MAX_STALLED_COUNT=3
QUEUE_RETRY_DELAY=2000

# Cron Jobs
FEED_PROCESSING_CRON=0,30 * * * *  # A cada 30 minutos
QUEUE_STATS_CRON=0 * * * *          # A cada hora

# Performance Tuning para processamento de feeds
MAX_FEED_ITEMS_TO_PROCESS=10
CONTENT_EXTRACTION_TIMEOUT=30000
FEED_PARSING_TIMEOUT=15000

# Configuração do Supabase
# Obtenha essas informações no painel do Supabase em Settings > API
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Configuração do YouTube Data API (opcional)
# Para obter durações de vídeos do YouTube
# Obtenha uma API key em: https://console.developers.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Exemplo de como obter as chaves:
# 1. Acesse o painel do Supabase (https://app.supabase.com)
# 2. Vá para Settings > API
# 3. Copie o valor em "Project URL" para SUPABASE_URL
# 4. Copie o valor em "Project API keys" > "anon public" para SUPABASE_ANON_KEY
# 5. Copie o valor em "Project API keys" > "service_role" para SUPABASE_SERVICE_ROLE_KEY (⚠️ MANTENHA SECRETO!)
# 6. Copie o valor em "JWT Secret" para SUPABASE_JWT_SECRET

# QStash Configuration Example
# Copy this file to .env and fill in your actual values

# QStash Token from Upstash Console
QSTASH_TOKEN=your_qstash_token_here

# QStash Signing Keys for webhook verification
QSTASH_CURRENT_SIGNING_KEY=your_current_signing_key_here
QSTASH_NEXT_SIGNING_KEY=your_next_signing_key_here

# Base URL where your application is deployed
# This is used to construct the webhook URL for QStash callbacks
WEBHOOK_BASE_URL=https://your-app-domain.com

# Example for local development:
# WEBHOOK_BASE_URL=http://localhost:3000

# Example for production:
# WEBHOOK_BASE_URL=https://rss-processor.yourcompany.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...your_stripe_secret_key...
STRIPE_WEBHOOK_SECRET=whsec_...your_webhook_endpoint_secret...

# Stripe Price IDs for specific products
STRIPE_MONTHLY_PRICE_ID=price_...your_monthly_price_id...
STRIPE_YEARLY_PRICE_ID=price_...your_yearly_price_id...

# ===== STRIPE CONFIGURATION =====
# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Stripe Webhook Secret for signature verification
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend URLs for checkout redirect
FRONTEND_URL=http://localhost:3000
CHECKOUT_SUCCESS_URL=${FRONTEND_URL}/subscription/success
CHECKOUT_CANCEL_URL=${FRONTEND_URL}/subscription/cancel

# Customer Portal return URL
CUSTOMER_PORTAL_RETURN_URL=${FRONTEND_URL}/account

# ===== RESEND EMAIL CONFIGURATION =====
# Resend API Key - obtenha em: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email "From" address - deve ser um domínio verificado no Resend
# Para teste, você pode usar: onboarding@resend.dev
# Para produção, use seu próprio domínio: noreply@seudominio.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email de suporte para contato
SUPPORT_EMAIL=support@feedagg.com

# URL do frontend para links em emails (opcional)
# Importante: Esta URL é usada para carregar a logo nos emails (feedagg-logo.png)
# Certifique-se de que a pasta public seja servida estaticamente
FRONTEND_URL=http://localhost:3000
