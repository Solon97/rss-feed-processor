{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "assets": [
      {
        "include": "email/templates/**/*.html",
        "outDir": "dist"
      }
    ]
  },
  "projects": {
    "abstract-stripe": {
      "type": "library",
      "root": "libs/abstract-stripe",
      "entryFile": "index",
      "sourceRoot": "libs/abstract-stripe/src",
      "compilerOptions": {
        "tsConfigPath": "libs/abstract-stripe/tsconfig.lib.json"
      }
    }
  }
}